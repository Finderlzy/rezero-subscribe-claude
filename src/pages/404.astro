---
import Numeral from '../components/Numeral.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TocNav from '../components/TocNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSite } from '../lib/site';
import { withBase } from '../lib/with-base';
import '../styles/toc.css';

/**
 * 找不到页（design §4.6，AC-18）：大号 `404`（固定字形，Numeral）、“找不到这一页”、一句说明，“回到首页”（主）和“打开目录”（次），
 * 目录直接写在页面上，“打开目录”跳到它，不靠 JS。
 */
const site = await loadSite();
---

<BaseLayout title="找不到这一页">
  <SiteHeader />
  <main id="main" class="page">
    <p class="not-found-no"><Numeral text="404" label="404" /></p>
    <h1 class="page-title">找不到这一页</h1>
    <p>这个地址没有对应的页面，可能是链接写错了。可以回到首页，或者从下面的目录找。</p>
    <p class="page-actions">
      <a class="button" href={withBase('/')}>回到首页</a>
      <a class="button button-secondary" href="#not-found-toc">打开目录</a>
    </p>
    <section class="not-found-toc" aria-labelledby="not-found-toc">
      <h2 id="not-found-toc" class="not-found-toc-title">目录</h2>
      <TocNav outline={site.route.outline({}, null, 'principle')} references={site.tocReferences} label="全站目录" />
    </section>
  </main>
</BaseLayout>

<style>
  .not-found-no {
    margin: 0 0 var(--space-5);
    color: var(--text);
    font-size: var(--fs-display);
    line-height: 1;
  }

  .not-found-toc {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--border);
  }

  .not-found-toc-title {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
    font-weight: var(--fw-heading);
  }
</style>
