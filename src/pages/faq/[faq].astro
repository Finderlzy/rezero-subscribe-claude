---
import { render } from 'astro:content';
import CodeCopy from '../../components/CodeCopy.astro';
import Toc from '../../components/Toc.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSite } from '../../lib/site';
import { withBase } from '../../lib/with-base';
import '../../styles/prose.css';

/**
 * 每条常见问题一页：/faq/<faq-id>/（ADR-0002，design §4.6，FR-20）。不在步骤序列里，没有上一步/下一步。
 * 从步骤链接进来（`?from=<step-id>`）时，页面脚本在标题上方和正文末尾显示“← 返回刚才的步骤：<步骤名>”；
 * 末尾总有常见问题列表入口（直接打开时靠它找别的条目）和“打开目录”（FR-20，同找不到页）。
 */
export async function getStaticPaths() {
  const site = await loadSite();
  return [...site.faq.keys()].map((faq) => ({ params: { faq } }));
}

const { faq } = Astro.params;
const site = await loadSite();
const entry = site.faq.get(faq)!;
const { Content } = await render(entry);
// 页面脚本只需要“步骤标识 → 标题”来写返回链接；内嵌 JSON 里的 `<` 转义掉（同 StepLayout）。
const stepTitles = Object.fromEntries(Object.entries(site.route.data.steps).map(([id, step]) => [id, step.title]));
const stepsJson = JSON.stringify(stepTitles).replace(/</g, '\\u003c');
---

<BaseLayout title={entry.data.title}>
  <main id="main" class="page">
    <p class="faq-return" data-faq-return hidden>
      <a>← 返回刚才的步骤</a>
    </p>
    <h1 class="page-title">{entry.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    <p class="faq-return" data-faq-return hidden>
      <a>← 返回刚才的步骤</a>
    </p>
    <p class="page-actions">
      <button type="button" class="button button-secondary" data-toc-open hidden>打开目录</button>
      <a class="button" href={withBase('/faq/')}>{site.faqPage.data.title}列表</a>
    </p>
  </main>
  <Toc outline={site.route.outline({}, null)} mode="drawer" routeData={site.route.data} />
  <CodeCopy />
  <script type="application/json" id="faq-steps" set:html={stepsJson} />
</BaseLayout>

<script>
  import { initCodeZoom } from '../../scripts/code-zoom';
  import { initFaqReturn } from '../../scripts/faq-return';
  import { initToc } from '../../scripts/toc';

  initFaqReturn(document);
  initToc(document);
  initCodeZoom(document);
</script>

<style>
  .faq-return {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .faq-return a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .prose + .faq-return {
    margin-top: var(--space-6);
  }
</style>
