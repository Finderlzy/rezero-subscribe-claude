---
import { render } from 'astro:content';
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { loadSite } from '../../lib/site';

/** 常见问题：/faq/，一页，条目是二级标题，步骤里的双链指向 `/faq/?from=<页面>#<条目>`（FR-20）。 */
const site = await loadSite();
const faq = site.references.get('faq')!;
const { Content } = await render(faq.entry);
---

<ReferenceLayout title={faq.title}>
  <Content />
</ReferenceLayout>
