---
import { render } from 'astro:content';
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { loadSite } from '../../lib/site';

/**
 * 常见问题的各条：/faq/<id>/，一问一页（FR-20）。正文是重写稿里同名的单条问题文件，由 import-rewrite.mjs 导入到
 * src/content/reference/faq/<id>.md（ADR-0005）：文件名就是标识（也是 URL，ADR-0002），第一行的 # 标题对应重写稿的文件名。
 * 页脚是“回到：常见问题”；步骤里的双链指向 `/faq/<id>/?from=<页面>`。
 */
export async function getStaticPaths() {
  const site = await loadSite();
  return [...site.references.keys()]
    .filter((id) => id.startsWith('faq/'))
    .map((id) => ({ params: { question: id.slice('faq/'.length) } }));
}

const { question } = Astro.params;
const site = await loadSite();
const item = site.references.get(`faq/${question}`)!;
const faq = site.references.get('faq')!;
const { Content } = await render(item.entry);
---

<ReferenceLayout title={item.title} eyebrow={`附录 · ${faq.title}`} back={{ href: '/faq/', title: faq.title }}>
  <Content />
</ReferenceLayout>
