---
import { render } from 'astro:content';
import GroupInvite from '../components/GroupInvite.astro';
import VideoFacade from '../components/VideoFacade.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { loadSite } from '../lib/site';

/**
 * 步骤页、选择页、旁支页共用一个标识空间：/<id>/（ADR-0002）。只输出原理版正文（用户 2026-10-22 决定：
 * 去掉视图切换、固定原理视图；内容集合里的操作版条目暂不删，等单版本重写统一处理）；
 * 导航按“原理视图 + 未选”在构建时写好，打开只属于一个分支的页面时按它所属的选项计算（架构 §3 M3）。
 */
export async function getStaticPaths() {
  const site = await loadSite();
  return [...site.pages.keys()].map((page) => ({ params: { page } }));
}

const { page: id } = Astro.params;
const site = await loadSite();
const page = site.pages.get(id)!;
const { data } = page.principle;
const view = site.route.view(id, {}, 'principle');
const { Content: Principle } = await render(page.principle);
/** 附录页正文末尾放 QQ 群入口（FR-22）：卡住了来查的地方，也是问人的地方 */
const GROUP_INVITE_PAGE = 'appendix';
---

<PageLayout title={page.title} view={view} routeData={site.route.data} tocReferences={site.tocReferences} skipLabel={data.skipLabel}>
  <VideoFacade slot="video" video={data.video} stepTitle={page.title} />
  <Principle slot="principle" />
  {id === GROUP_INVITE_PAGE && <GroupInvite slot="after" />}
</PageLayout>
