---
import { render } from 'astro:content';
import ChoiceOption from '../../components/ChoiceOption.astro';
import StepLayout from '../../layouts/StepLayout.astro';
import { pathOf } from '../../lib/route/route-map';
import { loadSite } from '../../lib/site';
import { withBase } from '../../lib/with-base';

/**
 * 每个分叉点一个选择页：/choose/<fork-id>/（ADR-0002，design §4.2）。
 * h1 直接问问题，下面是引导语，再列出各个选项；底部的上一步/下一步按默认路线在构建时写好。
 */
export async function getStaticPaths() {
  const site = await loadSite();
  return Object.keys(site.route.data.forks).map((fork) => ({ params: { fork } }));
}

const { fork } = Astro.params;
const site = await loadSite();
const entry = site.choices.get(fork)!;
const view = site.route.view({ kind: 'choose', fork }, {});
// 选择页不计步数，顶部只写章节名：取目录里含当前选择页的那一章。
const chapter = view.outline.find((c) => c.items.some((item) => item.kind === 'choose' && item.current));
if (!chapter) throw new Error(`route.yaml：找不到选择页 ${fork} 所在的章节`);
const defaultOption = site.route.data.defaults[fork];
// 每个选项进入它的第一步：按“选了这个选项”的路线算选择页的下一项，规则只写在 M2 里。
const options = Object.entries(entry.data.options).map(([option, meta]) => ({
  id: option,
  ...meta,
  href: withBase(pathOf(site.route.view({ kind: 'choose', fork }, { [fork]: option }).next)),
}));
const { Content } = await render(entry);
---

<StepLayout
  at={{ kind: 'choose', fork }}
  title={entry.data.question}
  progress={null}
  chapter={chapter.title}
  prev={view.prev}
  next={view.next}
  doneTitle={site.done.data.title}
  routeData={site.route.data}
  outline={view.outline}
>
  <Content />
  <ul class="choice-options" aria-label="选项">
    {
      options.map((option) => (
        <li>
          <ChoiceOption
            option={option.id}
            href={option.href}
            title={option.title}
            path={option.path}
            effort={option.effort}
            audience={option.audience}
            isDefault={option.id === defaultOption}
          />
        </li>
      ))
    }
  </ul>
</StepLayout>

<style>
  .choice-options {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
</style>
