---
import { render } from 'astro:content';
import Toc from '../components/Toc.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathOf } from '../lib/route/route-map';
import { loadSite } from '../lib/site';
import { withBase } from '../lib/with-base';
import '../styles/prose.css';

/**
 * 完成页（design §4.6，FR-19、FR-51）。致谢、后记、联系方式写在 pages/done.md 里；联系方式在作者提供前是占位（需求 Q-07）。
 * done.md 的 title（“完成”）只用作页面标题和“下一步：完成”的链接文字，页面上的大标题按设计写“这条路线走完了”。
 * 末尾是“重新开始”（主按钮）、“回到目录”和“清除进度”；后两个要靠页面脚本，没有 JS 时隐藏。
 */
const site = await loadSite();
const { Content } = await render(site.done);
---

<BaseLayout title={site.done.data.title}>
  <main id="main" class="page">
    <h1 class="page-title">这条路线走完了</h1>
    <div class="prose">
      <Content />
    </div>
    <p class="page-actions">
      <a class="button" href={withBase(pathOf(site.start))}>重新开始</a>
      <button type="button" class="button button-secondary" data-toc-open hidden>回到目录</button>
      <button type="button" class="button button-secondary" data-done-clear hidden>清除进度</button>
    </p>
    <p class="done-status" data-done-status role="status"></p>
  </main>
  <Toc outline={site.route.outline({}, null)} mode="drawer" routeData={site.route.data} />
</BaseLayout>

<script>
  import { initDone } from '../scripts/done';
  import { initToc } from '../scripts/toc';

  initToc(document);
  initDone(document);
</script>

<style>
  .done-status {
    margin: var(--space-3) 0 0;
    color: var(--text-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .done-status:empty {
    display: none;
  }
</style>
