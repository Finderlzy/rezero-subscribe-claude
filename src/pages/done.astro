---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathOf } from '../lib/route/route-map';
import { loadSite } from '../lib/site';
import { withBase } from '../lib/with-base';
import '../styles/prose.css';

/**
 * 完成页（design §4.6，FR-19）。致谢、后记、联系方式写在 pages/done.md 里；联系方式在作者提供前是占位（需求 Q-07）。
 * done.md 的 title（“完成”）只用作页面标题和“下一步：完成”的链接文字，页面上的大标题按设计写“这条路线走完了”。
 */
const site = await loadSite();
const { Content } = await render(site.done);
---

<BaseLayout title={site.done.data.title}>
  <main id="main" class="page">
    <h1 class="page-title">这条路线走完了</h1>
    <div class="prose">
      <Content />
    </div>
    <p class="page-actions">
      <a class="button" href={withBase(pathOf(site.start))}>重新开始</a>
    </p>
  </main>
</BaseLayout>
