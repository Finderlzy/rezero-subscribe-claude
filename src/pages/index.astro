---
import GroupInvite from '../components/GroupInvite.astro';
import Logo from '../components/Logo.astro';
import Mascot from '../components/Mascot.astro';
import TocNav from '../components/TocNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathOf } from '../lib/route/route-map';
import { loadSite } from '../lib/site';
import { withBase } from '../lib/with-base';
import '../styles/toc.css';

/**
 * 首页（FR-18、AC-29，design v3 §4.4）：VuePress 默认首页的样子。没有顶栏、没有侧边栏，内容居中。
 *
 * 首屏：中文两行版 logo（h1，无障碍名称同时给出中文站名和英文副标题）、右下方的小形象、
 * 一句话（--text-muted）、紫色主按钮“从第 00 章开始 →”（全站唯一的实心按钮）和 QQ 群入口的紧凑版（FR-22）。
 * 一条细线下是按章目录：每章一个 h2“第 n 章　章名”，下面列出这一章的页面、分叉点的“或”分组和参考页。
 * 首页没有当前路线，所以目录全部展开、不折叠、不弱化；推荐的选项后标“推荐”。
 *
 * 一句话仍要求原样摘自整体思路的原理版正文（ADR-0005，design V14）：构建时核对，不通过就失败。
 * 没有“继续上次”、已读标记和进度（需求 Never），也没有 v2.2 的眉题、小字信息行、桌面章级索引和固定字形章节号。
 */
const site = await loadSite();

/** 进入整体思路的文字链接不再放在首屏；目录里照常列出这一页。 */
const OVERVIEW_ID = 'overview';
const overview = site.pages.get(OVERVIEW_ID);
if (!overview) throw new Error(`首页：构建核对用的页面 principle/${OVERVIEW_ID}.md 不存在`);

/*
 * logo 下的一句话：摘自整体思路的原理版正文，去掉开头的“所以”和加粗（作者 2026-10-17 确认，实施计划 v2.1 §6）。
 * 构建时核对它原样出现在正文里（ADR-0005）；按 Markdown 原文比较，去掉加粗。
 */
const TAGLINE = '下面每一步，其实都在做同一件事：让每一项信息都不露出“我在国内”，而且像一个普通用户。';
if (!(overview.principle.body ?? '').replaceAll('**', '').includes(TAGLINE)) {
  throw new Error(`首页：logo 下的一句话没有原样出现在 principle/${OVERVIEW_ID}.md 的正文里（去掉加粗后比较）`);
}

const outline = site.route.outline({}, null, 'principle');
---

<BaseLayout
  description={`Re:从零开始订阅 claude 的分步教程，从准备材料到订阅成功，每一步都有原理和操作。${TAGLINE}`}
  footerCentered
>
  <main id="main" class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-logo">
        <h1 id="home-title" class="home-title"><Logo variant="zh" /></h1>
        <Mascot />
      </div>
      <p class="home-tagline">{TAGLINE}</p>
      <p class="home-actions">
        <a class="button home-start" href={withBase(pathOf(site.start))} data-home-start
          >从第 00 章开始<span class="button-arrow" aria-hidden="true">→</span></a
        >
      </p>
      <GroupInvite compact />
    </section>

    <section id="home-chapters" class="home-chapters" aria-label="站点目录">
      <TocNav
        outline={outline}
        references={site.tocReferences}
        label="全站目录"
        home
        forks={site.route.data.forks}
      />
    </section>
  </main>
</BaseLayout>

<style>
  /* 首页整体：内容居中，最宽 960px（design §4.4）；顶部留白手机 40px、平板起 64px。 */
  .home {
    max-width: 960px;
    margin: 0 auto;
    padding: calc(var(--space-6) + var(--space-2)) var(--gutter) var(--space-7);
  }

  @media (min-width: 720px) {
    .home {
      padding-top: var(--space-8);
    }
  }

  /* 首屏：logo、一句话、主按钮和 QQ 群小字都居中（design §4.4） */
  .home-hero {
    text-align: center;
  }

  /* logo 是 h1，宽 ≤560px、手机满宽；小形象在它的右下方（design §4.4、V16 的位置） */
  .home-logo {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    /* 给小形象留出下方一行：它在 logo 的右下方，不和字重叠（design §4.4 的示意） */
    padding-bottom: var(--mascot-height);
  }

  .home-title {
    margin: 0;
    line-height: 0;
  }

  /* logo 的 SVG 自带按字号算出的宽高，这里按宽度缩放（Logo.astro） */
  .home-title :global(svg) {
    width: 100%;
    max-width: 560px;
    height: auto;
  }

  .home-logo :global(.mascot) {
    position: absolute;
    right: 0;
    bottom: 0;
  }

  /* logo 到一句话 32px；一句话最宽 24em、居中、--text-muted（design §3.2、§4.4） */
  .home-tagline {
    max-width: 24em;
    margin: var(--space-6) auto 0;
    color: var(--text-muted);
    font-size: var(--fs-tagline);
    line-height: var(--lh-tagline);
  }

  /* 一句话到主按钮 32px；按钮下 20px 是 QQ 群小字（GroupInvite 的紧凑版） */
  .home-actions {
    margin: var(--space-6) 0 0;
  }


  /*
   * 一条 1px 细线隔开首屏和目录，上下各 48px（design §4.4）。
   * 目录本身左对齐、宽同正文栏（--measure），在页面里居中摆放；章标题是 h2（toc.css 的 .toc-home）。
   */
  .home-chapters {
    max-width: var(--measure);
    margin: var(--space-7) auto 0;
    padding-top: var(--space-7);
    border-top: var(--border-width) solid var(--border);
    text-align: left;
  }
</style>
