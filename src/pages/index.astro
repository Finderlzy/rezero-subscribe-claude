---
import Logo from '../components/Logo.astro';
import TocNav from '../components/TocNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathOf } from '../lib/route/route-map';
import { loadSite } from '../lib/site';
import { withBase } from '../lib/with-base';
import '../styles/toc.css';

/**
 * 首页（FR-18，design §4.4）：没有页眉。中文两行版 logo（含中间一行英文）、“开始”（进入前言），一条细线下是按章排列的目录。
 * 没有“继续上次”和已读标记。首页没有视图，目录按原理版目录页的样子画：全部页面正常显示，
 * 原理独有步骤只标“原理”，不弱化；没有脚本，不按本机选择改写。章节号是首页唯一的装饰。
 */
const site = await loadSite();
---

<BaseLayout>
  <main id="main" class="page home">
    <h1 class="home-title"><Logo variant="zh" /></h1>

    <p class="page-actions">
      <a class="button home-start" href={withBase(pathOf(site.start))} data-home-start>开始<span aria-hidden="true">→</span></a>
    </p>

    <section class="home-chapters" aria-labelledby="home-chapters">
      <h2 id="home-chapters" class="home-chapters-title">目录</h2>
      <TocNav outline={site.route.outline({}, null, 'principle')} references={site.tocReferences} label="全站目录" home />
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    padding-top: var(--space-6);
  }

  @media (min-width: 720px) {
    .home {
      padding-top: var(--space-8);
    }
  }

  .home-title {
    margin: 0;
    line-height: 0;
  }

  /* logo 的 SVG 自带按字号算出的宽高，这里按宽度缩放，窄屏不溢出（Logo.astro）；左对齐，宽不超过 560px。 */
  .home-title :global(svg) {
    width: 100%;
    max-width: 560px;
    height: auto;
  }

  .home-start {
    gap: var(--space-2);
  }

  .home-chapters {
    margin-top: var(--space-7);
    border-top: var(--border-width) solid var(--border);
  }

  .home-chapters-title {
    margin: var(--space-5) 0 var(--space-4);
    color: var(--text-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
  }
</style>
