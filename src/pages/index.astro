---
import GroupInvite from '../components/GroupInvite.astro';
import Logo from '../components/Logo.astro';
import Mascot from '../components/Mascot.astro';
import UpdateEntry from '../components/UpdateEntry.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathOf } from '../lib/route/route-map';
import { loadSite } from '../lib/site';
import { latestEntries, UPDATE_LOG_PATH } from '../lib/update-log';
import { withBase } from '../lib/with-base';

/**
 * 首页（FR-18、AC-29，design v3 §4.4）：VuePress 默认首页的样子。没有顶栏、没有侧边栏，内容居中。
 *
 * 首屏：中文两行版 logo（h1，无障碍名称同时给出中文站名和英文副标题）、右下方的小形象、
 * 一句话（--text-muted）、紫色主按钮“从第 00 章开始 →”（首页唯一的实心按钮）和 QQ 群入口的紧凑版（FR-22）。
 *
 * 一条细线下是五章简介（作者 2026-10-22 决定）：桌面五栏从左到右排成一行，平板三栏、手机一栏；
 * 每栏只写章名（链到这一章的第一页）和 `route.yaml` 的 summary，不再列具体页面。
 * 首页没有“继续上次”、已读标记和进度（需求 Never），也没有 v2.2 的眉题、小字信息行、桌面章级索引和固定字形章节号。
 *
 * 一句话仍要求原样摘自整体思路的原理版正文（ADR-0005，design V14）：构建时核对，不通过就失败。
 *
 * v0.13（FR-87）：五章简介下面、页脚上面再加一节“最近更新”，列出「全部」分类排在最前的 5 条
 * （含置顶公告），标题旁“查看全部 →”进 /update-log/。首屏和五章简介块不动（作者 2026-10-23 要求），
 * 排版沿用首页现有风格，不新造卡片。
 */
const site = await loadSite();
const chapters = site.route.data.chapters;
// 首页的“最近更新”：和 /update-log/ 的「全部」分类排在最前的 5 条完全一致（FR-87）
const latest = latestEntries(site.updateLog);

/** 进入整体思路的文字链接不再放在首屏；下面的章节简介里也不列页面。 */
const OVERVIEW_ID = 'overview';
const overview = site.pages.get(OVERVIEW_ID);
if (!overview) throw new Error(`首页：构建核对用的页面 principle/${OVERVIEW_ID}.md 不存在`);

/*
 * logo 下的一句话：摘自“整体思路与方案选型”的正文，去掉加粗（作者 2026-10-17 确认；V10 换成新稿里的那句话）。
 * 构建时核对它原样出现在正文里（ADR-0005）；按 Markdown 原文比较，去掉加粗。
 */
const TAGLINE = '让 Claude 能看到的每一项信息，都指向一个 Claude 支持地区的普通用户，并且用得像个普通人。';
if (!(overview.principle.body ?? '').replaceAll('**', '').includes(TAGLINE)) {
  throw new Error(`首页：logo 下的一句话没有原样出现在 principle/${OVERVIEW_ID}.md 的正文里（去掉加粗后比较）`);
}

/*
 * 五章简介的文案写在 route.yaml 的 summary（导航文案，不是导入的正文）：五栏都要有，缺了就构建失败。
 * 章名链到这一章的第一页；章节的第一项是分支段时取第一个选项的第一个页面。
 */
const missingSummary = chapters.filter((chapter) => chapter.summary === undefined).map((chapter) => chapter.id);
if (missingSummary.length > 0) {
  throw new Error(`首页：route.yaml 的章节缺少 summary：${missingSummary.join('、')}`);
}

function chapterEntryId(chapter: (typeof chapters)[number]): string {
  const first = chapter.items[0];
  if (first === undefined) throw new Error(`首页：章节 ${chapter.id} 没有页面`);
  if (first.kind === 'step' || first.kind === 'choose') return first.id;
  const entry = Object.values(first.options)[0]?.[0];
  if (entry === undefined) throw new Error(`首页：章节 ${chapter.id} 的第一个分支段没有页面`);
  return entry;
}
---

<BaseLayout
  description={`Re:从零开始订阅 claude 的分步教程，从准备材料到订阅成功，每一步都有原理和操作。${TAGLINE}`}
  footerCentered
>
  <main id="main" class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-logo">
        <h1 id="home-title" class="home-title"><Logo variant="zh" /></h1>
        <Mascot />
      </div>
      <p class="home-tagline">{TAGLINE}</p>
      <p class="home-actions">
        <a class="button home-start" href={withBase(pathOf(site.start))} data-home-start
          >从第 00 章开始<span class="button-arrow" aria-hidden="true">→</span></a
        >
      </p>
      <GroupInvite compact />
    </section>

    <section id="home-chapters" class="home-chapters" aria-label="章节简介">
      <ol class="home-chapter-list">
        {
          chapters.map((chapter) => (
            <li class="home-chapter">
              <h2 class="home-chapter-title">
                <a href={withBase(`/${chapterEntryId(chapter)}/`)}>{chapter.title}</a>
              </h2>
              <p class="home-chapter-summary">{chapter.summary}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="home-updates" class="home-updates" aria-labelledby="home-updates-title" data-home-updates>
      <div class="home-updates-head">
        <h2 class="home-updates-title" id="home-updates-title">最近更新</h2>
        <a class="home-updates-more" href={withBase(UPDATE_LOG_PATH)} data-home-updates-more>
          查看全部<span aria-hidden="true"> →</span>
        </a>
      </div>
      {
        latest.length === 0 ? (
          <p class="home-updates-empty">还没有更新。</p>
        ) : (
          <ol class="home-updates-list">
            {latest.map((entry) => (
              <UpdateEntry entry={entry} fallbackHref={UPDATE_LOG_PATH} compact />
            ))}
          </ol>
        )
      }
    </section>
  </main>
</BaseLayout>

<style>
  /* 首页整体：内容居中，最宽 1120px（五栏简介要放得下）；顶部留白手机 40px、平板起 64px。 */
  .home {
    max-width: 1120px;
    margin: 0 auto;
    padding: calc(var(--space-6) + var(--space-2)) var(--gutter) var(--space-7);
  }

  @media (min-width: 720px) {
    .home {
      padding-top: var(--space-8);
    }
  }

  /* 首屏：logo、一句话、主按钮和 QQ 群小字都居中，最宽 960px（design §4.4） */
  .home-hero {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }

  /* logo 是 h1，宽 ≤560px、手机满宽；小形象在它的右下方（design §4.4、V16 的位置） */
  .home-logo {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    /* 给小形象留出下方一行：它在 logo 的右下方，不和字重叠（design §4.4 的示意） */
    padding-bottom: var(--mascot-height);
  }

  .home-title {
    margin: 0;
    line-height: 0;
  }

  /* logo 的 SVG 自带按字号算出的宽高，这里按宽度缩放（Logo.astro） */
  .home-title :global(svg) {
    width: 100%;
    max-width: 560px;
    height: auto;
  }

  .home-logo :global(.mascot) {
    position: absolute;
    right: 0;
    bottom: 0;
  }

  /* logo 到一句话 32px；一句话最宽 24em、居中、--text-muted（design §3.2、§4.4） */
  .home-tagline {
    max-width: 24em;
    margin: var(--space-6) auto 0;
    color: var(--text-muted);
    font-size: var(--fs-tagline);
    line-height: var(--lh-tagline);
  }

  /* 一句话到主按钮 32px；按钮下 20px 是 QQ 群小字（GroupInvite 的紧凑版） */
  .home-actions {
    margin: var(--space-6) 0 0;
  }

  /*
   * 一条 1px 细线隔开首屏和章节简介，上下各 48px（design §4.4）。
   * 五章从左到右：手机一栏、平板三栏（3 + 2），桌面五栏一行；简介左对齐。
   */
  .home-chapters {
    margin: var(--space-7) auto 0;
    padding-top: var(--space-7);
    border-top: var(--border-width) solid var(--border);
    text-align: left;
  }

  .home-chapter-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .home-chapter-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .home-chapter-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* 章名是这一栏的标题（h2），链到这一章的第一页；不要“第 n 章” */
  .home-chapter-title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: var(--fw-heading);
  }

  .home-chapter-title a {
    color: var(--text);
    text-decoration: none;
  }

  .home-chapter-title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  /* 简介：--text-muted；五栏时每栏约 190px，16px 一行约 12 个汉字 */
  .home-chapter-summary {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-body);
    line-height: var(--lh-tagline);
  }

  /*
   * 最近更新（v0.13、FR-87）：和五章简介之间一条细线隔开，标题和“查看全部 →”一行，
   * 下面 5 条和五章简介同一内容宽度（--content-width），左缘对齐。
   */
  .home-updates {
    max-width: var(--content-width);
    margin: var(--space-7) auto 0;
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--border);
    text-align: left;
  }

  .home-updates-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-2);
  }

  .home-updates-title {
    margin: 0;
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: var(--fw-heading);
  }

  .home-updates-more {
    color: var(--accent);
    font-size: var(--fs-meta);
    text-decoration: none;
  }

  .home-updates-more:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /*
   * 最近更新（作者 2026-10-25）：和五章简介一样横着排 5 列，每列里日期、类型、标题竖着排。
   * 栅格和 .home-chapter-list 同断点（平板 3 栏 3 + 2、手机一栏），保证两块的节奏一致。
   */
  .home-updates-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .home-updates-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .home-updates-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .home-updates-empty {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-meta);
  }
</style>