---
import Logo from '../components/Logo.astro';
import TocNav from '../components/TocNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathOf } from '../lib/route/route-map';
import { loadSite } from '../lib/site';
import { withBase } from '../lib/with-base';
import '../styles/toc.css';

/**
 * 首页（FR-18）：logo、站名、英文副标题、“开始”（进入前言）和按章排列的目录。
 * 没有“继续上次”。首页的版式和目录的首页变体在 #30、#31 重做。
 */
const site = await loadSite();
---

<BaseLayout>
  <main id="main" class="page home">
    <h1 class="home-title"><Logo variant="zh" /></h1>
    <p class="home-subtitle" lang="en">Re:Zero − Starting Life with Claude</p>

    <p class="page-actions">
      <a class="button" href={withBase(pathOf(site.start))} data-home-start>开始</a>
    </p>

    <section aria-labelledby="home-chapters">
      <h2 id="home-chapters" class="home-chapters-title">目录</h2>
      <TocNav outline={site.route.outline({}, null, 'operation')} label="全站目录" />
    </section>
  </main>
</BaseLayout>

<style>
  .home-title {
    margin: 0;
    line-height: 0;
  }

  /* logo 的 SVG 自带按字号算出的宽高，这里按宽度缩放，窄屏不溢出（Logo.astro）。 */
  .home-title :global(svg) {
    width: 100%;
    max-width: 480px;
    height: auto;
    --logo-re: var(--accent);
  }

  .home-subtitle {
    margin: var(--space-2) 0 var(--space-6);
    color: var(--text-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    font-weight: 500;
  }

  .home-chapters-title {
    margin: var(--space-7) 0 var(--space-3);
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
    font-weight: 600;
  }
</style>
