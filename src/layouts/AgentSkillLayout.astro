---
import '../styles/prose.css';
import CodeCopy from '../components/CodeCopy.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Toc from '../components/Toc.astro';
import { AGENT_SKILL_PATH, AGENT_SKILL_ZIP_PATH, SKILL_NAME } from '../lib/agent-skill/index';
import { AGENT_INSTALL_DIR, AGENT_INSTALL_PROMPT } from '../lib/agent-skill/install-prompt';
import { describe, AGENT_SKILL_KEY, SITE_NAME } from '../lib/seo';
import { loadSite } from '../lib/site';
import { withBase } from '../lib/with-base';
import BaseLayout from './BaseLayout.astro';

/**
 * Agent Skill 页的骨架（v0.15，design §4.10，FR-115、FR-116）。
 *
 * 和更新日志页一样是“顶栏 + 侧边栏 | 正文区”的独立页面（design §4.10）：h1 是“Agent Skill”，
 * 不进上一步/下一步、目录的章节列表和站内搜索，进 sitemap 和 seo.yaml（键 AGENT_SKILL_KEY）。
 * 页面文字写在站点代码里，不从重写稿导入（FR-115）。
 *
 * 侧边栏/抽屉底部的两条常驻入口里，这一页自己的“Agent Skill”是当前态（currentAgentSkill）。
 * 首屏下面先给“让 Agent 自己装”的提示词（Claude Code 以外）：文字在 src/lib/agent-skill/install-prompt.ts，
 * README 里是同一段；提示词块套用 Markdown 代码块的样式和复制按钮（CodeCopy + initCodeCopy）。
 * 目录脚本照常跑（架构 §14.5：独立页面也要跑 initToc）。
 */
const site = await loadSite();
// 目录按“未选”画（和更新日志页一样，Skill 页不上路线图）；浏览器里的目录脚本要这份数据
const outline = site.route.outline({}, null, 'principle');
const routeJson = JSON.stringify(site.route.data).replace(/</g, '\\u003c');
// 面包屑的结构化数据要绝对地址：首页和这一页（含部署根路径）
const siteRoot = new URL(withBase('/'), Astro.site ?? Astro.url).href;
const pageUrl = new URL(withBase(AGENT_SKILL_PATH), Astro.site ?? Astro.url).href;
// Skill 的版本和站点版本一致（架构 §16.8）：页面直接读 package.json，不和生成物另对一遍（构建对照已管）
const { version } = await import('../../package.json');
---

<BaseLayout
  title="Agent Skill"
  description={describe(site.seo, AGENT_SKILL_KEY)}
  jsonLd="article"
  breadcrumbs={[{ name: SITE_NAME, url: siteRoot }, { name: 'Agent Skill', url: pageUrl }]}
>
  <SiteHeader toc />
  <Toc outline={outline} references={site.tocReferences} referencesChapter={site.referenceChapter.id} currentAgentSkill />
  <div class="page-view">
    <main id="main" class="agent-skill-page">
      <div class="page-body">
        <h1 class="step-title">Agent Skill</h1>
        <p class="agent-skill-intro">
          把整份教程装进你自己的 AI Agent：它按路线带你走每一步，电脑上的命令、配置和收尾清理可以替你做，
          手机、账号和付款只引导你自己操作。
        </p>

        <section class="agent-skill-section" aria-labelledby="agent-skill-prompt">
          <h2 class="agent-skill-heading" id="agent-skill-prompt">让 Agent 自己装（Claude Code 以外）</h2>
          <p>
            用 Codex、Gemini CLI、Qwen Code、OpenCode 这类能执行命令的 Agent 的读者，不用自己下载：
            把下面这段整个发给你的 Agent，它会下载 zip、解压到当前项目的 <code>{AGENT_INSTALL_DIR}</code>（不写全局目录），
            然后直接开始。
          </p>
          <p>
            只能聊天、不能在你电脑上执行命令的 Agent（网页版聊天）用不了这段，只能按下面的手动安装用引导部分。
          </p>
          <div class="prose agent-skill-prompt" data-agent-skill-prompt>
            <pre><code>{AGENT_INSTALL_PROMPT}</code></pre>
          </div>
        </section>

        <section class="agent-skill-section" aria-labelledby="agent-skill-install">
          <h2 class="agent-skill-heading" id="agent-skill-install">手动安装（Claude Code 等）</h2>
          <p>
            Claude Code 或想自己装的读者：下载 zip，把里面的 <code>{SKILL_NAME}</code> 目录整个放进 Skill 目录。
            大部分 Agent 认下面两个目录之一：
          </p>
          <p class="agent-skill-download">
            <a class="button" href={withBase(AGENT_SKILL_ZIP_PATH)} download data-agent-skill-download
              >下载 {SKILL_NAME}.zip</a
            >
          </p>
          <p class="agent-skill-version">当前版本 {version}（和 zip 里的一致）</p>
          <!-- 横向可滚的表格要能用键盘聚焦（axe 的 scrollable-region-focusable，和 Markdown 表格的 rehype 处理一致） -->
          <table tabindex="0">
            <thead>
              <tr><th>Agent</th><th>Skill 放的目录</th></tr>
            </thead>
            <tbody>
              <tr><td>Codex</td><td><code>~/.agents/skills/</code></td></tr>
              <tr><td>Gemini CLI</td><td><code>~/.agents/skills/</code>（或自己的 <code>~/.gemini/skills/</code>）</td></tr>
              <tr><td>Qwen Code</td><td><code>~/.agents/skills/</code>（或自己的 <code>~/.qwen/skills/</code>）</td></tr>
              <tr><td>OpenCode</td><td><code>~/.agents/skills/</code>、<code>~/.claude/skills/</code> 或 <code>~/.config/opencode/skills/</code></td></tr>
              <tr><td>Claude Code</td><td><code>~/.claude/skills/</code></td></tr>
            </tbody>
          </table>
          <p>
            只能聊天、不能在你电脑上执行命令的 Agent（网页版聊天）装了也只能用引导部分：
            它没法替你跑命令和清理，代办的部分要换能执行命令的 Agent。
          </p>
        </section>

        <section class="agent-skill-section" aria-labelledby="agent-skill-can">
          <h2 class="agent-skill-heading" id="agent-skill-can">它能做什么、不做什么</h2>
          <div class="agent-skill-columns">
            <div>
              <h3 class="agent-skill-sub">能做（替你做）</h3>
              <ul>
                <li>按路线图一步步引导，记住你做到哪了（进度记在你本机的一个文件里）</li>
                <li>电脑上的命令、配置文件和一键脚本，经你确认后替你执行</li>
                <li>装好代理软件后帮你查系统、改时区、核对节点自测结果</li>
                <li>结束时清理临时文件、shell 历史里的密码和临时 SSH 密钥</li>
              </ul>
            </div>
            <div>
              <h3 class="agent-skill-sub">不做（只引导）</h3>
              <ul>
                <li>手机上的全部步骤：注册、订阅、代理 App 和系统设置都由你自己点</li>
                <li>买服务器、买 ISP 代理和住宅服务器、注册账号和过 KYC：只讲怎么做，不代办</li>
                <li>不操作你的浏览器和图形界面，代理软件的界面要你自己配</li>
                <li>不改商家的命令、优惠码，也不推荐教程以外的商家</li>
              </ul>
            </div>
          </div>
        </section>

        <section class="agent-skill-section" aria-labelledby="agent-skill-start">
          <h2 class="agent-skill-heading" id="agent-skill-start">装好以后</h2>
          <p>手动装好以后，对你的 Agent 说一句开始语：</p>
          <p class="agent-skill-phrase"><code>带我订阅 Claude</code></p>
          <p>
            用上面的提示词让 Agent 自己装的，它会直接进入开场，不用再说。它先问你几个问题
            （确认风险提示、识别电脑系统、选节点方案和手机系统），然后按路线带你走。
          </p>
        </section>

        <section class="agent-skill-section" aria-labelledby="agent-skill-credentials">
          <h2 class="agent-skill-heading" id="agent-skill-credentials">凭据和清理</h2>
          <p>
            替你登录服务器时需要服务器密码，住宅 ISP 代理还需要地址、端口、用户名和密码：这些只在执行需要它们的命令时用，
            对话里回显会打码，必须落盘时放在你的系统临时目录、用完就删。进度文件里只记做到哪一步和你的系统、方案，
            不写密码、服务器 IP、节点链接和邮箱。
          </p>
          <p>
            结束时做收尾清理：删掉临时目录和临时 SSH 密钥，删掉 shell 历史里带密码的行，关掉为面板开的 SSH 隧道和留在后台的连接，
            再核对进度文件里没有凭据。服务器上的节点文件和面板信息不删，你以后还要用。
          </p>
          <p>清不掉的：对话记录留在 Agent 和服务商那里，Skill 删不掉它们；介意的话结束时新建对话。</p>
        </section>
      </div>
    </main>
  </div>
  <CodeCopy />
  <script type="application/json" id="route-data" set:html={routeJson} />
</BaseLayout>

<script>
  import { initToc } from '../scripts/toc';
  import { pageReaderStore, readRouteData } from '../scripts/reader-store';
  import { initCodeCopy } from '../scripts/code-zoom';

  // Agent Skill 页也有目录：<720px 的抽屉、“目录”按钮和侧边栏当前项都靠目录脚本（和参考页一样）
  const data = readRouteData(document);
  if (data) initToc(document, data, pageReaderStore(data));
  // 安装提示词块是手写的 .prose pre：复制按钮和 Markdown 代码块走同一个脚本
  initCodeCopy(document);
</script>

<style>
  /*
   * 独立页面的正文栏：和 UpdateLogLayout 的骨架同一套（正文宽度、上下边距、h1）。
   * 两处都是手写页面、结构一样，先各留一份，改 design §3.3、§4.6 时两处一起改。
   */
  .page-body {
    box-sizing: border-box;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--content-pad-top) var(--gutter) var(--space-7);
  }

  .step-title {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    font-weight: var(--fw-heading);
  }

  .page-view {
    min-width: 0;
  }

  .agent-skill-intro {
    margin: 0 0 var(--space-5);
    color: var(--text-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-tagline);
  }

  /*
   * 安装提示词块（design §4.10）：套用 §4.7 的代码块外观和复制按钮（.prose pre + initCodeCopy），
   * 但长句自动折行——提示词不是命令，不该让读者横向滚着读，也不该在 360px 撑出滚动区。
   */
  .agent-skill-prompt {
    margin: 0 0 var(--space-3);
  }

  .agent-skill-page .agent-skill-prompt pre {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* 提示词块和 Markdown 代码块同样用正文的字号：页面级 .agent-skill-page code 的 0.875em 只给正文行内代码 */
  .agent-skill-page .agent-skill-prompt pre code {
    font-size: inherit;
  }

  .agent-skill-download {
    margin: 0;
  }

  .agent-skill-version {
    margin: var(--space-2) 0 0;
    color: var(--text-faint);
    font-size: var(--fs-caption);
  }

  .agent-skill-section {
    margin: var(--space-6) 0 0;
  }

  .agent-skill-heading {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: var(--fw-heading);
  }

  .agent-skill-section p {
    margin: 0 0 var(--space-3);
  }

  /*
   * 行内代码和表格照 design §4.7（更新日志页那种手写页面不走 Markdown 的 .prose，
   * 规则抄在这里）：行内代码浅底 4px 圆角；表格全格线 + 隔行底色、表头不折行、
   * 在自己的容器里横向滚动（360px 不撑破页面），第一列粘性固定。
   */
  .agent-skill-page code {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
  }

  .agent-skill-page :not(pre) > code {
    padding: 2px 6px;
    border-radius: var(--radius-inline);
    background: var(--surface-muted);
  }

  .agent-skill-page table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 0 0 var(--space-3);
  }

  .agent-skill-page th,
  .agent-skill-page td {
    padding: var(--space-2) calc(var(--space-3) + 2px);
    border: var(--border-width) solid var(--border);
    text-align: left;
  }

  .agent-skill-page th {
    color: var(--text);
    background: var(--surface-muted);
    font-weight: var(--fw-heading);
    white-space: nowrap;
  }

  .agent-skill-page :is(th, td):first-child {
    position: sticky;
    left: 0;
    z-index: 1;
  }

  .agent-skill-page td:first-child {
    background: var(--bg);
  }

  .agent-skill-page tbody tr:nth-child(even) > * {
    background: var(--surface-muted);
  }

  /* 能做 / 不做：两列清单（design §4.10），<720px 一列堆叠 */
  .agent-skill-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0 0 var(--space-3);
  }

  @media (max-width: 719px) {
    .agent-skill-columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .agent-skill-sub {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-body);
    font-weight: var(--fw-heading);
  }

  .agent-skill-columns ul {
    margin: 0;
    padding-inline-start: 1.4em;
  }

  .agent-skill-columns li {
    margin: 0 0 var(--space-2);
    line-height: var(--lh-body);
  }

  .agent-skill-phrase code {
    font-size: var(--fs-h3);
    font-weight: var(--fw-heading);
  }
</style>
