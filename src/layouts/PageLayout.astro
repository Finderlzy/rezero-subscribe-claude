---
import CodeCopy from '../components/CodeCopy.astro';
import ImageZoom from '../components/ImageZoom.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StepNav from '../components/StepNav.astro';
import Toc from '../components/Toc.astro';
import { hasZoomableImage } from '../lib/code-zoom/labels';
import { chapterNoText, isChapterStart, progressText } from '../lib/nav-text';
import { VIEW_BOOT_SCRIPT } from '../lib/reader-state/view-boot';
import type { RouteData, RouteView } from '../lib/route/types';
import type { TocReference } from '../lib/site';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

/**
 * 步骤页、选择页、旁支页的骨架（design §4.1、§4.2，架构 §3 M3）：顶部进度和标题，视频，正文，底部导航。
 *
 * 两版正文（ADR-0004）：`principle`、`operation` 两个 slot 分别渲染进 `data-body="principle|operation"`，
 * 由 `<html data-view>` 决定显示哪一个（prose.css）；`<head>` 里的 VIEW_BOOT_SCRIPT 在首次绘制前设置它，
 * 没有 JS 时没有 data-view，固定显示操作版。只有原理版的页面传 `notice`：只输出原理版，
 * 操作视图下在正文上方显示这句说明（FR-21、FR-30）。
 *
 * 导航按“操作视图 + 未选”在构建时写好（`view`）；页面脚本 route-enhance 读内嵌的 RouteData（`#route-data`），
 * 按本机选择和当前视图改写导航；view-toggle 处理页眉的“操作｜原理”切换（架构 §3 M3）。
 * 目录（design v2.1 §4.5、D5）：所有宽度都是抽屉，由页眉的“目录”打开（toc.ts）；没有 JS 时“目录”链到首页的完整目录。
 * 眉题（design §4.1）：章节号 + 进度文字，两端的短横由 CSS 画；每章第一页（含选择页）在眉题上方多一块章节过场。
 */
interface Props {
  title: string;
  /** `routeMap.view(id, {}, 'operation')` */
  view: RouteView;
  /** `routeMap.data`：内嵌进页面，浏览器用它重算导航 */
  routeData: RouteData;
  /** `site.tocReferences`：目录末尾单列的参考页 */
  tocReferences: TocReference[];
  skipLabel?: string | undefined;
  /** 只有原理版时传：操作视图下正文上方的说明。传了就不渲染 `operation` slot */
  notice?: string | undefined;
}

const { title, view, routeData, tocReferences, skipLabel, notice } = Astro.props;
// 内嵌在 <script> 里的 JSON 不能出现 `</script>`，把 `<` 转义掉。
const routeJson = JSON.stringify(routeData).replace(/</g, '\\u003c');
const principle = await Astro.slots.render('principle');
// 不能用 Astro.slots.has 判断：页面里写成条件渲染的 slot 即使为空也算“有”
const operation = notice === undefined ? await Astro.slots.render('operation') : undefined;
const hasZoom = [principle, operation].some((html) => html !== undefined && hasZoomableImage(html));
const chapterNo = chapterNoText(view.progress.chapterNo);
const chapterStart = isChapterStart(routeData.chapters, view.progress, view.current);
---

<BaseLayout title={title}>
  <script is:inline slot="head" set:html={VIEW_BOOT_SCRIPT} />
  <SiteHeader views toc />
  <Toc outline={view.outline} references={tocReferences} />
  <main id="main" class="step" data-route-at={view.current.kind === 'home' ? undefined : view.current.id}>
    <header class="step-header">
      {
        chapterStart && (
          <div class="chapter-intro" aria-hidden="true">
            <span class="chapter-intro-no">{chapterNo}</span>
            <span class="chapter-intro-title">{view.progress.chapter}</span>
          </div>
        )
      }
      <p class="eyebrow">
        <span class="eyebrow-no" aria-hidden="true">{chapterNo}</span>
        <span data-route-progress>{progressText(view.progress, view.current)}</span>
      </p>
      <h1 class="step-title">{title}</h1>
    </header>
    <slot name="video" />
    {
      operation === undefined ? (
        <>
          <p class="view-notice">{notice}</p>
          <div class="prose" set:html={principle} />
        </>
      ) : (
        <>
          <div class="prose" data-body="principle" set:html={principle} />
          <div class="prose" data-body="operation" set:html={operation} />
        </>
      )
    }
    <StepNav prev={view.prev} next={view.next} returnTo={view.returnTo} skipTo={view.skipTo} skipLabel={skipLabel} />
  </main>
  <CodeCopy />
  {hasZoom && <ImageZoom />}
  <script type="application/json" id="route-data" set:html={routeJson} />
</BaseLayout>

<script>
  import { initCodeZoom } from '../scripts/code-zoom';
  import { pageReaderStore, readRouteData } from '../scripts/reader-store';
  import { initRouteEnhance } from '../scripts/route-enhance';
  import { initToc } from '../scripts/toc';
  import { initViewToggle } from '../scripts/view-toggle';

  const data = readRouteData(document);
  const store = pageReaderStore(data);
  // 先 view-toggle：从往返缓存恢复时它先把视图改回本机保存的值，route-enhance 再按它重算；
  // route-enhance 在目录之前：它先记下这一页所属的选项，目录再按这条路线画。
  initViewToggle(document, store);
  if (data) {
    initRouteEnhance(document, data, store);
    initToc(document, data, store);
  }
  initCodeZoom(document);
</script>

<style>
  .step {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-6) var(--gutter) var(--space-7);
  }

  /* 章节过场（design §4.1）：大号章节号 + 章节名 + 一条细线，上下各留 32px；“从零开始”的点缀，只在每章第一页。 */
  .chapter-intro {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-width) solid var(--border);
  }

  .chapter-intro-no {
    color: var(--accent);
    font-family: var(--font-numeral);
    font-size: var(--fs-numeral);
    line-height: 1;
    font-weight: 400;
  }

  .chapter-intro-title {
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    font-weight: 700;
  }

  .step-title {
    margin: 0 0 var(--space-5);
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    font-weight: 800;
  }

  /* 手机上底栏吸底：正文末尾预留等高留白，最后一段不被挡住（design §5）。
     72px ≈ 底栏按钮 56px + 上下内边距各 8px（另有 1px 上边框，由 --space-7 兜住）；改底栏高度时同步这里。 */
  @media (max-width: 719px) {
    .step {
      padding-bottom: calc(72px + var(--space-7) + env(safe-area-inset-bottom));
    }
  }
</style>
