---
import CodeCopy from '../components/CodeCopy.astro';
import ImageZoom from '../components/ImageZoom.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StepNav from '../components/StepNav.astro';
import Toc from '../components/Toc.astro';
import { hasZoomableImage } from '../lib/code-zoom/labels';
import { fillFigureSteps } from '../lib/content/rehype-figures';
import { eyebrowText, figurePrefix, progressText } from '../lib/nav-text';
import { VIEW_BOOT_SCRIPT } from '../lib/reader-state/view-boot';
import type { RouteData, RouteView } from '../lib/route/types';
import type { TocReference } from '../lib/site';
import type { TocSection } from '../lib/toc-sections';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

/**
 * 步骤页、选择页、旁支页的骨架（design v3 §4.1、§4.2，架构 §13.3）：顶栏 + 两栏（侧边栏 | 正文区）。
 * 正文区里是正文栏（--content-width，在剩余宽度里居中）：h1 上方一行灰色眉题，纯文字 h1，视频，正文，底部导航。
 * v2.2 的页头色带、章首页的副标题/章名/一句话都去掉了（FR-72），小形象挪到顶栏站名旁（SiteHeader）。
 *
 * 眉题一行写“第 1 章 · 准备节点和住宅 IP · 第 2 步，共 10 步”；选择页写“· 选择”，旁支页写“· 旁支”。
 * 看得见的部分不进无障碍树，读屏读它自己那一句（progressText）；步数和眉题由 route-enhance 按当前路线改写
 * （挂载点 `[data-route-eyebrow]`、`[data-route-progress]` 名字不变）。
 *
 * 只显示原理版正文（用户 2026-10-22 决定：去掉“操作｜原理”视图切换，页面固定原理视图；内容集合里的操作版数据暂不删，
 * 等 docs/v3-rewrite 的单版本重写统一处理）。`<head>` 里的 VIEW_BOOT_SCRIPT 固定写 `data-view="principle"`，
 * 只用来标记“页面脚本会运行”（route-enhance、toc 的视图固定为 principle）；没有 JS 时没有 data-view，
 * 构建时的导航本来就按原理视图写好。
 *
 * 导航按“原理视图 + 未选”在构建时写好；页面脚本 route-enhance 读内嵌的 RouteData（`#route-data`），
 * 按本机选择改写导航。
 * 目录（design §4.5）：≥720px 是左侧常驻的侧边栏（Toc.astro 的 aside），sticky、独立滚动；
 * <720px 是抽屉，由顶栏的“目录”打开（toc.ts）。没有 JS 时侧边栏是静态 HTML，照样能点。
 * 当前页正文的 h2 由调用方经 `sections` 传进来，列在侧边栏当前项下面（FR-16）。
 */
interface Props {
  title: string;
  /** `routeMap.view(id, {}, 'principle')` */
  view: RouteView;
  /** `routeMap.data`：内嵌进页面，浏览器用它重算导航 */
  routeData: RouteData;
  /** `site.tocReferences`：目录末尾附录分组里的参考页 */
  tocReferences: TocReference[];
  /** 当前页正文的 h2：列在侧边栏当前项下面（design §4.5，FR-16） */
  sections?: TocSection[];
  skipLabel?: string | undefined;
}

const { title, view, routeData, tocReferences, sections = [], skipLabel } = Astro.props;
// 内嵌在 <script> 里的 JSON 不能出现 `</script>`，把 `<` 转义掉。
const routeJson = JSON.stringify(routeData).replace(/</g, '\\u003c');
// 截图编号的步骤号（design §4.7）：构建时按原理视图写，没有 JS 时就是它；route-enhance 按当前选择改写
const principle = fillFigureSteps(await Astro.slots.render('principle'), figurePrefix(view.progress, view.current));
const hasZoom = hasZoomableImage(principle);
---

<BaseLayout title={title}>
  <script is:inline slot="head" set:html={VIEW_BOOT_SCRIPT} />
  <SiteHeader toc />
  <Toc outline={view.outline} references={tocReferences} sections={sections} openChapterId={view.progress.chapterId} />
  <div class="page-view">
    <main id="main" class="step" data-route-at={view.current.kind === 'home' ? undefined : view.current.id}>
      <div class="step-body">
        {/* 眉题的样式是 base.css 的全局 .eyebrow（design §4.1） */}
        <p class="eyebrow">
          <span aria-hidden="true" data-route-eyebrow set:text={eyebrowText(view.progress, view.current)} />
          <span class="visually-hidden" data-route-progress>{progressText(view.progress, view.current)}</span>
        </p>
        <h1 class="step-title">{title}</h1>
        <slot name="video" />
        <div class="prose" set:html={principle} />
        <slot name="after" />
        <StepNav prev={view.prev} next={view.next} returnTo={view.returnTo} skipTo={view.skipTo} skipLabel={skipLabel} />
      </div>
    </main>
  </div>
  <CodeCopy />
  {hasZoom && <ImageZoom />}
  <script type="application/json" id="route-data" set:html={routeJson} />
</BaseLayout>

<script>
  import { initCodeZoom } from '../scripts/code-zoom';
  import { pageReaderStore, readRouteData } from '../scripts/reader-store';
  import { initRouteEnhance } from '../scripts/route-enhance';
  import { initToc } from '../scripts/toc';

  const data = readRouteData(document);
  const store = pageReaderStore(data);
  // route-enhance 在目录之前：它先记下这一页所属的选项，目录再按这条路线画。
  if (data) {
    initRouteEnhance(document, data, store);
    initToc(document, data, store);
  }
  initCodeZoom(document);
</script>

<style>
  .page-view {
    min-width: 0;
  }

  /* 正文栏（design §3.3）：宽 --content-width，在正文区里居中；上内边距手机 24px、平板起 32px，左右 --gutter */
  .step-body {
    box-sizing: border-box;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--content-pad-top) var(--gutter) var(--space-7);
  }

  /* h1（design §3.2、§4.1）：大号纯文字，背后没有色带，下面不画线 */
  .step-title {
    min-width: 0;
    margin: 0 0 var(--space-5);
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    font-weight: var(--fw-heading);
  }

  /*
   * 构建时的眉题和截图编号的步骤号按“原理视图 + 未选”算；有 JS 时（VIEW_BOOT_SCRIPT 总会设 data-view）先占位不显示，
   * 等 route-enhance 按本机选择重算完（data-route-ready）再露出，选过分叉点的读者不会看到步数跳变。
   * 没有 JS 时没有 data-view，构建时的文字照常显示。
   */
  :global(:root[data-view]) .step:not([data-route-ready]) [data-route-eyebrow],
  :global(:root[data-view]) .step:not([data-route-ready]) :global(.plate-no) {
    visibility: hidden;
  }

  /* 手机上吸底底栏：正文末尾预留等高留白，最后一段不被挡住（design §5）；底栏高度见 tokens.css 的 --mobile-bar-height（V04 去掉吸底后删） */
  @media (max-width: 719px) {
    .step-body {
      padding-bottom: calc(var(--mobile-bar-height) + var(--space-7) + env(safe-area-inset-bottom));
    }
  }
</style>
