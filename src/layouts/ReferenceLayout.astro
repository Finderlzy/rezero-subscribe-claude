---
import CodeCopy from '../components/CodeCopy.astro';
import GroupInvite from '../components/GroupInvite.astro';
import ImageZoom from '../components/ImageZoom.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Toc from '../components/Toc.astro';
import { hasZoomableImage } from '../lib/code-zoom/labels';
import { loadSite } from '../lib/site';
import type { TocSection } from '../lib/toc-sections';
import { withBase } from '../lib/with-base';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

/**
 * 参考页（常见问题和各条问题、IP 质量实测合集和各篇实测）的骨架（design v3 §4.6，FR-20）：只有一版正文，
 * 没有上一步/下一步。
 *
 * 和步骤页一样是“顶栏 + 侧边栏 | 正文区”（design §3.3）：正文栏里 h1 上方一行灰色眉题“附录 · <标题>”，
 * 下面是纯文字 h1（v2.2 的页头色带去掉了，FR-72；小形象在顶栏站名旁）。
 * 从步骤链接进来（`?from=<page-id>`）时，页面脚本在正文上方和正文末尾显示“← 返回刚才的步骤：<标题>”；
 * 页脚只有“回到：…”：各条问题回常见问题，各篇实测回 IP 质量实测合集，两个参考页首页回附录（FR-20）。
 * 正文末尾、返回链接之后放 QQ 群入口（FR-22）：在常见问题里没找到答案，就进群问。
 * 参考页不进入上一步/下一步序列（requirements FR-20，取代 v2.2 计划 W5 第 2、3 条的“上一条 / 下一条”）。
 *
 * 目录（design §4.5）：和步骤页一样内嵌 #route-data 和 Toc——≥720px 左侧常驻，<720px 是抽屉。
 * 参考页不上路线图，只按本机选择画目录；当前参考页高亮在附录章下面，各条问题、各篇实测高亮它们的上级。
 */
interface Props {
  title: string;
  /** h1 上方的眉题，例如“附录 · 常见问题”；不传时只写“附录” */
  eyebrow?: string | undefined;
  back?: { href: string; title: string } | undefined;
  /** 侧边栏里要高亮的参考页：常见问题、IP 质量实测合集；各条问题、各篇实测填它们的上级 */
  currentReference: string;
  /** 这一页自己的 h2；各条问题、各篇实测也传，小节挂在上级参考项下面 */
  sections?: TocSection[] | undefined;
}

const { title, eyebrow = '附录', back, currentReference, sections = [] } = Astro.props;
const body = await Astro.slots.render('default');
const hasZoom = hasZoomableImage(body);
const site = await loadSite();
// 页面脚本只需要“页面标识 → 标题”来写返回链接；内嵌 JSON 里的 `<` 转义掉（同 PageLayout）。
const pageTitles = Object.fromEntries(Object.entries(site.route.data.pages).map(([id, page]) => [id, page.title]));
const pagesJson = JSON.stringify(pageTitles).replace(/</g, '\\u003c');
// 目录按同一条路线数据画（只用来判断“其他路线”，参考页本身不上路线图）
const routeJson = JSON.stringify(site.route.data).replace(/</g, '\\u003c');
---

<BaseLayout title={title}>
  <SiteHeader toc />
  <Toc outline={site.route.outline({}, null, 'principle')} references={site.tocReferences} sections={sections} currentReference={currentReference} />
  <div class="page-view">
    <main id="main" class="reference-page">
      <div class="page-body">
        <p class="eyebrow">{eyebrow}</p>
        <p class="reference-return reference-return-top" data-reference-return hidden>
          <a>
            <span class="step-nav-dir"><span aria-hidden="true">←</span> 返回刚才的步骤</span>
            <span class="step-nav-title" data-reference-return-title></span>
          </a>
        </p>
        <h1 class="step-title">{title}</h1>
        <div class="prose" set:html={body} />
        <GroupInvite />
        <nav class="reference-nav" aria-label="返回" data-reference-nav hidden={!back}>
          {
            back && (
              <a class="reference-back" href={withBase(back.href)}>
                <span class="step-nav-dir">
                  <span aria-hidden="true">←</span> 回到
                </span>
                <span class="step-nav-title">{back.title}</span>
              </a>
            )
          }
          <p class="reference-return" data-reference-return hidden>
            <a>
              <span class="step-nav-dir"><span aria-hidden="true">←</span> 返回刚才的步骤</span>
              <span class="step-nav-title" data-reference-return-title></span>
            </a>
          </p>
        </nav>
      </div>
    </main>
  </div>
  <CodeCopy />
  {hasZoom && <ImageZoom />}
  <script type="application/json" id="reference-pages" set:html={pagesJson} />
  <script type="application/json" id="route-data" set:html={routeJson} />
</BaseLayout>

<script>
  import { initCodeZoom } from '../scripts/code-zoom';
  import { pageReaderStore, readRouteData } from '../scripts/reader-store';
  import { initReferenceReturn } from '../scripts/reference-return';
  import { initSectionHash } from '../scripts/section-hash';
  import { initToc } from '../scripts/toc';

  initReferenceReturn(document);
  // 参考页也放目录（v2.2 D8、W3 第 7 条）：目录按本机选择画，当前项是 null（参考页不在路线上）
  const data = readRouteData(document);
  if (data) initToc(document, data, pageReaderStore(data));
  initCodeZoom(document);
  // 放在最后：前面的脚本会展开“返回刚才的步骤”等 DOM，之后补一次滚动才不会被布局变化带偏
  initSectionHash(document);
</script>

<style>
  /* 正文栏：和步骤页一样的宽度和边距（design §3.3） */
  .page-body {
    box-sizing: border-box;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--content-pad-top) var(--gutter) var(--space-7);
  }

  .step-title {
    margin: 0 0 var(--space-5);
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    font-weight: var(--fw-heading);
  }

  /* 正文区在侧边栏右边居中（base.css 的页面网格）；这里只保证不会被撑宽 */
  .page-view {
    min-width: 0;
  }

  /*
   * 参考页的“回到”和“返回刚才的步骤”（design §4.6）：和步骤页的翻页同样的文字链接，
   * 两行、可点区域 44px；正文末尾一条细线下面，左边“← 回到”，右边“← 返回刚才的步骤”（有 ?from= 时）。
   */
  .reference-nav {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--border);
  }

  .reference-nav[hidden] {
    display: none;
  }

  .reference-back,
  .reference-return a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 48%;
    min-height: 44px;
    padding: var(--space-1) 0;
    box-sizing: border-box;
    text-decoration: none;
  }

  .reference-return {
    margin: 0 0 var(--space-4);
  }

  /* h1 上方的“返回刚才的步骤”只有一块，不按两块的 48% 收窄 */
  .reference-return-top a {
    max-width: none;
  }

  /* 正文末尾的“返回刚才的步骤”在“回到”右边；块本身最多占一半，链接不再按块宽收窄（否则会缩成一团） */
  .reference-nav .reference-return {
    max-width: 48%;
    margin: 0 0 0 auto;
    text-align: right;
  }

  .reference-nav .reference-return a {
    max-width: none;
    margin-left: auto;
    align-items: flex-end;
  }

  .step-nav-dir {
    color: var(--text-muted);
    font-size: var(--fs-caption);
    line-height: var(--lh-meta);
  }

  .step-nav-title {
    color: var(--accent);
    font-size: var(--fs-body);
    line-height: var(--lh-heading);
    font-weight: var(--fw-heading);
  }

  .reference-back:hover .step-nav-title,
  .reference-return a:hover .step-nav-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
