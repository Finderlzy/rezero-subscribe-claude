---
import { withBase } from '../lib/with-base';
import Logo from './Logo.astro';
import ViewToggle from './ViewToggle.astro';

/**
 * 页眉（design §4.0，v2.2）：首页以外的所有页面都有，吸顶，高 56px，--bg 底，底边一条 1px --border 细线（没有视图色带）。
 * 左边是“目录”（只在 <1100px 显示，≥1100px 由常驻侧边栏代替，v2.2 D8）和链到首页的 logo 标记 + 站名（<480px 时只留标记）。
 * “目录”（`toc`）构建时是指向首页完整目录 `/#home-chapters` 的链接，没有 JS 也能到达目录（design §5，FR-16），
 * 页面脚本 toc.ts 把它换成打开抽屉的按钮（换元素时保留这里的属性，样式照样选得中）。
 * 右边是“操作｜原理”切换（`views`），没有视图的页面（参考页、找不到页）不显示。
 */
interface Props {
  /** 页面有两种视图：显示切换控件，色带跟视图换色 */
  views?: boolean;
  /** 页面内嵌了目录抽屉（Toc.astro）：显示“目录”（≥1100px 由 CSS 隐藏） */
  toc?: boolean;
}

const { views = false, toc = false } = Astro.props;
---

<header class="site-header">
  <div class="site-header-bar">
    {
      toc && (
        <a class="toc-open" href={withBase('/#home-chapters')} data-toc-open>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          目录
        </a>
      )
    }
    <a class="site-home" href={withBase('/')} aria-label="Re:从零开始订阅 claude 首页">
      <span class="site-mark" aria-hidden="true"><Logo variant="mark" /></span>
      <span class="site-name" aria-hidden="true">从零开始订阅 claude</span>
    </a>
    {views && <ViewToggle />}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--bg);
    border-bottom: var(--border-width) solid var(--border);
  }

  /* 页眉的两侧边距和正文栏一致：手机 --gutter（16px），平板起 32px（design §4.0、§3.3），目录按钮的图标和正文左缘对齐 */
  .site-header-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* 页眉连同底边的 1px 细线一共 --header-height（56px）：侧边栏和吸顶元素都按 --header-height 贴在它下沿 */
    height: calc(var(--header-height) - var(--border-width));
    padding: 0 var(--gutter);
  }

  /* 站名和切换控件分居页眉两端（右对齐：logo 和站名占满左侧剩余宽度，切换控件贴右缘） */
  .site-home {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    /* 图标和站名离按钮 16px（--space-4），不是普通的 8px */
    margin: 0 var(--space-4) 0 var(--space-4);
    color: var(--text);
    text-decoration: none;
  }

  @media (min-width: 1100px) {
    .site-home {
      margin-left: 0;
      flex: 1 1 auto;
    }
  }

  /* logo 的 SVG 自带按字号算出的宽高，这里按高度缩放（Logo.astro）；高 24px、站名 16px 都按 design §4.0 */
  .site-mark :global(svg) {
    display: block;
    width: auto;
    height: 24px;
  }

  .site-name {
    font-size: 16px;
    line-height: 1;
    font-weight: var(--fw-heading);
    white-space: nowrap;
  }

  @media (max-width: 479px) {
    .site-name {
      display: none;
    }
  }

  .toc-open {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-1);
    min-width: 44px;
    min-height: 44px;
    box-sizing: border-box;
    padding: 0 var(--space-3) 0 var(--space-2);
    border: var(--border-width) solid var(--control-border);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-meta);
    font-weight: var(--fw-heading);
    text-decoration: none;
    cursor: pointer;
  }

  /* ≥1100px：左侧常驻侧边栏就是目录，页眉不再放“目录”按钮（v2.2 D8 第 5 条）。
     没有 JS 时它是链到首页目录的链接，也一起藏起来，侧边栏里的目录照样能点。
     要写在 .toc-open 的基础规则后面：同样的优先级，写在前面会被 display: inline-flex 盖掉。 */
  @media (min-width: 1100px) {
    .toc-open {
      display: none;
    }
  }

  /* 悬停时边框变 --text，同次按钮（design §5） */
  .toc-open:hover {
    border-color: var(--text);
  }

  /* 没有 JS 时它是链接，按下反馈要自己加（base.css 只管 button 和 .button） */
  .toc-open:active {
    translate: 0 var(--press-shift);
  }
</style>
