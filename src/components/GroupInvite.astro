---
import qrcode from '../assets/qq-group/qrcode.svg?raw';
import { GROUP_NUMBER, GROUP_URL } from '../lib/group';

/**
 * QQ 中转群入口（FR-22）：一句话介绍群里的大肥鱼，写出群号，再给一个加群链接；平板和桌面多一张二维码，用手机扫。
 * 手机上不放二维码：扫不了自己的屏幕，点链接直接拉起 QQ。
 * 二维码是加群链接 GROUP_URL（src/lib/group.ts）的素色版本（黑码白底，不用 QQ 自带的渐变样式，design §6），
 * 存在 src/assets/qq-group/qrcode.svg：用 Python 的 segno 生成（`segno.make(GROUP_URL, error='m')`，border 4、黑码透明底，
 * 再补上 viewBox），生成后用扫码工具核对过能解出 GROUP_URL。改链接要重新生成。
 * 放在首页首屏、附录页和每个参考页的正文末尾。
 */
interface Props {
  /** 首页首屏用紧凑版：只有一行文字和链接，不放二维码 */
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class:list={['group-invite', { 'group-invite-compact': compact }]} aria-label="QQ 中转群">
  <div class="group-invite-text">
    <p class="group-invite-lead">{compact ? '进 QQ 中转群问大肥鱼：' : '有问题？进 QQ 中转群问大肥鱼'}</p>
    {
      !compact && (
        <p class="group-invite-desc">大肥鱼是群里的 AI 嘉宾，24 小时在线。教程哪一步卡住了都可以问她，也可以随便聊。</p>
      )
    }
    <p class="group-invite-meta">
      群号 <span class="group-invite-number">{GROUP_NUMBER}</span>
      {compact && <span class="group-invite-sep" aria-hidden="true">·</span>}
      <a class="group-invite-link" href={GROUP_URL} rel="noopener">加入群聊<span aria-hidden="true"> →</span></a>
    </p>
  </div>
  {!compact && <div class="group-invite-qr" role="img" aria-label={`QQ 中转群二维码，群号 ${GROUP_NUMBER}`} set:html={qrcode} />}
</section>

<style>
  /*
   * 附录和参考页里是 §4.7 的普通提示块：--surface-muted 底、4px --accent 左色条、右侧 6px 圆角，
   * 内边距 12px 16px（几何和 prose.css 的 .callout 一致；QQ 中转群入口在 .prose 外面，所以这里再写一遍）。
   * 首页的紧凑版（§4.4）是一行 14px 小字“进 QQ 中转群问大肥鱼：群号 … · 加入群聊 →”，不带提示块的外壳。
   */
  .group-invite {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding: var(--space-3) var(--space-4);
    border-left: var(--space-1) solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--surface-muted);
  }

  .group-invite-compact {
    justify-content: center;
    margin-top: calc(var(--space-4) + var(--space-1));
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }

  /* 紧凑版把标题和群号、链接排成一行；窄屏折行时仍居中 */
  .group-invite-compact .group-invite-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0 var(--space-2);
  }

  .group-invite.group-invite-compact .group-invite-lead,
  .group-invite.group-invite-compact .group-invite-meta {
    margin-top: 0;
  }

  .group-invite.group-invite-compact .group-invite-meta {
    gap: 0 var(--space-2);
  }

  .group-invite p {
    margin: 0;
  }

  /* 提示块的第一行标签：13px 600 --accent（和 callout-title 一样） */
  .group-invite-lead {
    color: var(--accent);
    font-size: var(--fs-caption);
    line-height: var(--lh-meta);
    font-weight: var(--fw-heading);
  }

  .group-invite-compact .group-invite-lead {
    color: var(--text-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    font-weight: 400;
  }

  .group-invite-sep {
    color: var(--text-faint);
  }

  .group-invite .group-invite-desc {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  .group-invite .group-invite-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-4);
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .group-invite-number {
    color: var(--text);
    font-variant-numeric: tabular-nums;
    user-select: all;
  }

  /* 可点区域补足 44px 高（design §5） */
  .group-invite-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* 二维码要黑码白底才扫得出，深色模式下也保留白底 */
  .group-invite-qr {
    display: none;
    flex: none;
    width: 112px;
    line-height: 0;
    background: #ffffff;
  }

  .group-invite-qr :global(svg) {
    width: 100%;
    height: auto;
  }

  @media (min-width: 720px) {
    .group-invite-qr {
      display: block;
    }
  }
</style>
