---
// 章节标题卡的英文副标题 `− CHAPTER 0n −`（design §3.2、§4.1）：Roboto Condensed 700 转曲，13px 原大，
// 由 scripts/build-logo.mjs 生成四条（00–03），不手改。纯装饰，对读屏隐藏；颜色跟随 currentColor，
// 由使用方给 --text-muted。
import ch0 from '../assets/numerals/chapter-00.svg?raw';
import ch1 from '../assets/numerals/chapter-01.svg?raw';
import ch2 from '../assets/numerals/chapter-02.svg?raw';
import ch3 from '../assets/numerals/chapter-03.svg?raw';
import { escapeAttr } from '../lib/numeral';

interface Props {
  /** 章节号 0–3 */
  chapter: number;
  class?: string;
}

const sources = [ch0, ch1, ch2, ch3];
const { chapter, class: className } = Astro.props;
const source = sources[chapter];
if (source === undefined) throw new Error(`没有第 ${chapter} 章的英文副标题，只有 00–03`);
const cls = escapeAttr(className ? `chapter-subtitle ${className}` : 'chapter-subtitle');
const svg = source.replace('<svg ', `<svg class="${cls}" aria-hidden="true" focusable="false" `);
---

<Fragment set:html={svg} />
