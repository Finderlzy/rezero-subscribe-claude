---
import type { OutlineChapter } from '../lib/route/types';
import type { TocReference } from '../lib/site';
import type { TocSection } from '../lib/toc-sections';
import { AGENT_SKILL_PATH } from '../lib/agent-skill/index';
import { UPDATE_LOG_PATH } from '../lib/update-log';
import { withBase } from '../lib/with-base';
import TocNav from './TocNav.astro';
import '../styles/toc.css';

/**
 * 步骤目录（design v3 §4.5，FR-16）：≥720px 是左侧常驻的侧边栏，<720px 是抽屉（架构 §13.11 R-5：两份标记沿用）。
 *
 * 构建时按 `outline` 把全部章节和页面写两遍：一份在 `aside[data-toc-sidebar]`（静态 HTML，没有 JS 也照样能点），
 * 一份在 `<dialog>` 里。顶栏的“目录”（`[data-toc-open]`，SiteHeader）只在 <720px 显示（CSS），
 * 没有 JS 时是指向首页完整目录的链接；页面脚本 toc.ts 把它换成打开抽屉的按钮。
 * 两份用同一套标记契约（见下），都按构建时的当前路线写（页面固定原理视图）。
 * 分叉点只画当前选项，另一条路线收成一行 `a.toc-route-switch` 文字链接（作者 2026-10-23）；
 * 找不到页的目录（不折叠）仍列出所有选项。
 *
 * 标记契约：
 *   [data-toc-step]：每个步骤；
 *   [data-toc-choose]：选择页；[data-toc-option]：当前选项（或找不到页里的每个选项）。
 *
 * 更新日志入口（v0.13，FR-88）：侧边栏最底部和抽屉最底部各一条，**不跟着目录滚走**（侧边栏里它和滚动区
 * .toc-sidebar-scroll 是兄弟节点，滚动条只滚上面的列表），在更新日志页自己上是当前态（aria-current="page"）。
 */
interface Props {
  outline: OutlineChapter[];
  references: TocReference[];
  /** 当前页正文的 h2，列在当前项下面（design v3 §4.5，FR-16） */
  sections?: TocSection[];
  /** 参考页的当前项：IP 质量实测合集 */
  currentReference?: string;
  /** 参考页挂在目录里的哪一章（`site.referenceChapter.id`） */
  referencesChapter?: string;
  /** 要展开的章（旁支页不在 outline 里时由 PageLayout 传入） */
  openChapterId?: string;
  /** 当前页就是更新日志（v0.13、FR-88）：侧边栏底部的入口显示成当前态 */
  currentUpdateLog?: boolean;
  /** 当前页就是 Agent Skill 页（v0.15、FR-116）：侧边栏底部的入口显示成当前态 */
  currentAgentSkill?: boolean;
}

const { outline, references, sections = [], currentReference, referencesChapter, openChapterId, currentUpdateLog = false, currentAgentSkill = false } = Astro.props;
// 更新日志入口的文字：和分类名同一个来源（CONTEXT.md 的“更新日志”）
const UPDATE_LOG_LABEL = '更新日志';
// Agent Skill 入口的文字（v0.15、FR-116）
const AGENT_SKILL_LABEL = 'Agent Skill';
---

<aside class="toc-sidebar" data-toc-sidebar aria-label="步骤目录">
  <div class="toc-sidebar-scroll">
    <div class="toc-sidebar-inner">
      <TocNav
        outline={outline}
        references={references}
        label="步骤目录（侧边栏）"
        sidebar
        collapsible
        sections={sections}
        currentReference={currentReference}
        referencesChapter={referencesChapter}
        openChapterId={openChapterId}
      />
    </div>
  </div>
  <div class="toc-sidebar-foot">
    <a class="toc-foot-link" href={withBase(UPDATE_LOG_PATH)} data-toc-update-log aria-current={currentUpdateLog ? 'page' : undefined}>
      {UPDATE_LOG_LABEL}
    </a>
    <a class="toc-foot-link" href={withBase(AGENT_SKILL_PATH)} data-toc-agent-skill aria-current={currentAgentSkill ? 'page' : undefined}>
      {AGENT_SKILL_LABEL}
    </a>
  </div>
</aside>

<dialog class="toc-dialog" data-toc-dialog aria-labelledby="toc-dialog-title">
  <div class="toc-dialog-head">
    <h2 class="toc-dialog-title" id="toc-dialog-title">目录</h2>
    <button type="button" class="toc-close" data-toc-close aria-label="关闭目录">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="toc-dialog-body">
    <TocNav
      outline={outline}
      references={references}
      collapsible
      sections={sections}
      currentReference={currentReference}
      referencesChapter={referencesChapter}
      openChapterId={openChapterId}
    />
  </div>
  <div class="toc-dialog-foot">
    <a class="toc-foot-link" href={withBase(UPDATE_LOG_PATH)} data-toc-update-log aria-current={currentUpdateLog ? 'page' : undefined}>
      {UPDATE_LOG_LABEL}
    </a>
    <a class="toc-foot-link" href={withBase(AGENT_SKILL_PATH)} data-toc-agent-skill aria-current={currentAgentSkill ? 'page' : undefined}>
      {AGENT_SKILL_LABEL}
    </a>
  </div>
</dialog>