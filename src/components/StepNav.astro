---
import { stopTitle } from '../lib/nav-text';
import { pathOf } from '../lib/route/route-map';
import type { Stop } from '../lib/route/types';
import { withBase } from '../lib/with-base';

/**
 * 上一步 / 下一步（design §4.1，FR-11）。按钮里写出目标标题，不只写“下一步”（design §6）。
 * 链接在构建时按当前页的路线写好，不运行 JS 也能顺着走完；页面脚本 route-enhance 按本机选择和视图改写（data-route-* 挂载点）。
 * 前言的上一步、后记的下一步是首页；选择页未选时没有“下一步”（FR-12）：链接照样写出但带 `hidden`、没有地址，
 * 读者在本机选过之后由页面脚本显示出来。
 * 旁支页没有上一步，左边换成“回到：<挂靠的页面>”（FR-19）。
 * 可跳过步骤在“下一步”上方多一个文字按钮（design §4.1，FR-15）。它放在 nav 外面、正文流里：
 * 手机上底栏吸底，放进底栏会让底栏变高，正文末尾的留白就不够了。
 */
interface Props {
  prev: Stop | null;
  next: Stop | null;
  /** 只有旁支页才有：挂靠的普通页 */
  returnTo?: Stop | null;
  /** 可跳过步骤才有：跳过连续的可跳过步骤后到达的位置 */
  skipTo?: Stop | null;
  /** 跳过按钮文案（frontmatter 的 skipLabel），默认“跳过”（FR-15） */
  skipLabel?: string | undefined;
}

const { prev, next, returnTo = null, skipTo = null, skipLabel = '跳过' } = Astro.props;
const back = returnTo ?? prev;
const backLabel = returnTo ? '回到' : '上一步';
---

{
  skipTo && (
    <p class="step-skip" data-route-skip>
      <a href={withBase(pathOf(skipTo))} data-route-nav="skip">
        {skipLabel}
        <span aria-hidden="true"> →</span>
      </a>
    </p>
  )
}

{
  (back || next) && (
    <nav class="step-nav" aria-label="上一步和下一步">
      {back && (
        <a
          class="step-nav-link step-nav-prev"
          href={withBase(pathOf(back))}
          rel={returnTo ? undefined : 'prev'}
          data-return={returnTo ? '' : undefined}
          data-route-nav={returnTo ? 'return' : 'prev'}
        >
          <span class="step-nav-dir">
            <span aria-hidden="true">← </span>
            <span class="step-nav-dir-label">{backLabel}</span>
          </span>
          <span class="step-nav-title">
            <span class="visually-hidden">：</span>
            <span data-route-title>{stopTitle(back, 'prev')}</span>
          </span>
        </a>
      )}
      <a
        class="step-nav-link step-nav-next"
        href={next ? withBase(pathOf(next)) : undefined}
        hidden={!next}
        rel="next"
        data-route-nav="next"
      >
        <span class="step-nav-dir">
          下一步<span aria-hidden="true"> →</span>
        </span>
        <span class="step-nav-title">
          <span class="visually-hidden">：</span>
          <span data-route-title>{next ? stopTitle(next, 'next') : ''}</span>
        </span>
      </a>
    </nav>
  )
}

<style>
  .step-skip {
    display: flex;
    justify-content: flex-end;
    margin: var(--space-7) 0 0;
  }

  .step-skip a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .step-skip a:hover {
    text-decoration: underline;
  }

  /* 页面脚本按本机选择隐藏或显示跳过和“下一步”；下面的 display 会盖过 hidden 属性，这里补回来。 */
  .step-skip[hidden],
  .step-nav-link[hidden] {
    display: none;
  }

  .step-skip + .step-nav {
    margin-top: var(--space-3);
  }

  /* 桌面：正文结尾两个大块链接，写出方向和目标标题；“下一步”是主按钮，“上一步”是次按钮（design §4.1）。 */
  .step-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .step-nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 44px;
    padding: var(--space-4);
    border: var(--border-width) solid var(--control-border);
    border-radius: var(--radius-panel);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .step-nav-prev:hover {
    border-color: var(--accent);
  }

  .step-nav-next {
    grid-column: 2;
    text-align: right;
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .step-nav-next:hover .step-nav-title {
    text-decoration: underline;
  }

  .step-nav-dir {
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
  }

  .step-nav-prev .step-nav-dir {
    color: var(--text-muted);
  }

  .step-nav-title {
    font-weight: 700;
  }

  /* 手机：吸底的底栏，“下一步”约占 2/3 宽；“上一步”只留箭头（无障碍名称仍是“上一步：<标题>”）。正文末尾的留白见 PageLayout。 */
  @media (max-width: 719px) {
    .step-nav {
      position: fixed;
      inset: auto 0 0;
      z-index: 1;
      grid-template-columns: 1fr 2fr;
      gap: var(--space-2);
      margin: 0;
      padding: var(--space-2) var(--space-4) calc(var(--space-2) + env(safe-area-inset-bottom));
      background: var(--bg);
      border-top: var(--border-width) solid var(--border);
    }

    .step-nav-link {
      min-height: 56px;
      justify-content: center;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-control);
    }

    .step-nav-next {
      text-align: left;
    }

    .step-nav-title {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .step-nav-prev {
      align-items: center;
    }

    .step-nav-prev .step-nav-dir {
      color: var(--text);
      font-size: var(--fs-body);
    }

    /* 只在手机断点隐藏，所以不能直接套全局的 .visually-hidden。旁支页的“回到”保留文字，和“上一步”区分开。 */
    .step-nav-prev .step-nav-title,
    .step-nav-prev:not([data-return]) .step-nav-dir-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
