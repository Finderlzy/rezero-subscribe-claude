---
import { stopTitle } from '../lib/nav-text';
import { pathOf } from '../lib/route/route-map';
import type { Stop } from '../lib/route/types';
import { withBase } from '../lib/with-base';

/**
 * 上一步 / 下一步（design §4.1，FR-72、AC-30）：正文末尾一条细线下，左右两端各一块文字链接，
 * 每块两行——13px --text-muted 的“← 上一步”/“下一步 →”，下面 16px 600 --accent 的目标标题。
 * 链接在构建时按当前页的路线写好，不运行 JS 也能顺着走完；页面脚本 route-enhance 按本机选择改写（data-route-* 挂载点）。
 * 前言的上一步、后记的下一步是首页；选择页未选时没有“下一步”（FR-12）：链接照样写出但带 `hidden`、没有地址，
 * 读者在本机选过之后由页面脚本显示出来。
 * 旁支页没有上一步，左边换成“← 回到”+ 挂靠的页面（FR-19）。
 * 可跳过步骤在“下一步”下面 4px 多一行小字链接（design §4.1，FR-15），右对齐；
 * 手机和桌面一样排在正文末尾，不吸底（v3 取消了 v2.2 的底栏，design V11）。
 */
interface Props {
  prev: Stop | null;
  next: Stop | null;
  /** 只有旁支页才有：挂靠的普通页 */
  returnTo?: Stop | null;
  /** 可跳过步骤才有：跳过连续的可跳过步骤后到达的位置 */
  skipTo?: Stop | null;
  /** 跳过按钮文案（frontmatter 的 skipLabel），默认“跳过”（FR-15） */
  skipLabel?: string | undefined;
}

const { prev, next, returnTo = null, skipTo = null, skipLabel = '跳过' } = Astro.props;
const back = returnTo ?? prev;
const backLabel = returnTo ? '回到' : '上一步';
---

{
  (back || next) && (
    <nav class="step-nav" aria-label="上一步和下一步">
      {back && (
        <a
          class="step-nav-link"
          href={withBase(pathOf(back))}
          rel={returnTo ? undefined : 'prev'}
          data-route-nav={returnTo ? 'return' : 'prev'}
        >
          <span class="step-nav-dir">
            <span aria-hidden="true">←</span> {backLabel}
          </span>
          <span class="step-nav-title" data-route-title>
            {stopTitle(back, 'prev')}
          </span>
        </a>
      )}
      <div class="step-nav-forward">
        <a
          class="step-nav-link step-nav-next"
          href={next ? withBase(pathOf(next)) : undefined}
          hidden={!next}
          rel="next"
          data-route-nav="next"
        >
          <span class="step-nav-dir">
            下一步 <span aria-hidden="true">→</span>
          </span>
          <span class="step-nav-title" data-route-title>
            {next ? stopTitle(next, 'next') : ''}
          </span>
        </a>
        {skipTo && (
          <p class="step-skip" data-route-skip>
            <a href={withBase(pathOf(skipTo))} data-route-nav="skip">
              {skipLabel}
              <span aria-hidden="true"> →</span>
            </a>
          </p>
        )}
      </div>
    </nav>
  )
}

<style>
  /*
   * 翻页（design §4.1）：正文末尾 48px 后一条 1px --border 线，线下 16px 一行，左右两端对齐。
   * 只有一块时靠自己那一侧：back 在左，右边那一列（下一步 + 跳过）用 margin-left: auto 靠右；
   * “跳过”放在右边那一列里，所以总是距“下一步”4px，不会被上一步的折行推远。
   */
  .step-nav {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--border);
  }

  .step-nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 48%;
    min-height: 44px;
    padding: var(--space-1) 0;
    box-sizing: border-box;
    text-decoration: none;
  }

  /* 右边那一列：下一步和“跳过”，各靠右 */
  .step-nav-forward {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    max-width: 48%;
    margin-left: auto;
  }

  .step-nav-forward .step-nav-link {
    max-width: 100%;
    align-items: flex-end;
    text-align: right;
  }

  /* 第一行：13px --text-muted 的“← 上一步”/“下一步 →” */
  .step-nav-dir {
    color: var(--text-muted);
    font-size: var(--fs-caption);
    line-height: var(--lh-meta);
  }

  /* 第二行：16px 600 --accent 的目标标题；标题太长时折行，不截断 */
  .step-nav-title {
    color: var(--accent);
    font-size: var(--fs-body);
    line-height: var(--lh-heading);
    font-weight: var(--fw-heading);
  }

  .step-nav-link:hover .step-nav-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* “跳过”（FR-15）：下一步下面 4px，右对齐的一行 14px 文字链接，可点区域 44px 高 */
  .step-skip {
    display: flex;
    justify-content: flex-end;
    margin: var(--space-1) 0 0;
  }

  .step-skip a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    text-decoration: none;
  }

  .step-skip a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  /* 页面脚本按本机选择隐藏或显示跳过和“下一步”；上面的 display 会盖过 hidden 属性，这里补回来。 */
  .step-skip[hidden],
  .step-nav a[hidden] {
    display: none;
  }
</style>
