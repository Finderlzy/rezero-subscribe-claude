---
import { pathOf } from '../lib/route/route-map';
import type { OutlineBranch, OutlineChapter, OutlineStep } from '../lib/route/types';
import type { TocReference } from '../lib/site';
import type { TocSection } from '../lib/toc-sections';
import { withBase } from '../lib/with-base';
import TocSections from './TocSections.astro';

/**
 * 一章下面的目录项（TocNav.astro 的正文）：页面、分叉点的各个选项、参考页。
 * 侧边栏和抽屉里，分叉点的每个选项是一个可开合的 `<details>`：全部选项都显示，选中的（或当前页所在的）
 * 那个展开，没选中的收起（用户 2026-10-24）。找不到页的目录仍然平铺全部选项。
 * 当前页下面列出它的小节（design v3 §4.5，FR-16）；页面固定原理视图，只有一份小节列表。
 */
interface Props {
  items: OutlineChapter['items'];
  references: TocReference[];
  /** 当前页正文里的 h2；没有 h2 时不输出小节列表 */
  sections: TocSection[];
  /** 当前路线上的页面标识（参考页没有） */
  currentPageId: string | null;
  /** 参考页的当前项：常见问题、IP 质量实测合集；各条问题、各篇实测高亮它们的上级 */
  currentReference?: string | undefined;
  /** 最后一个（附录）章末尾列参考页 */
  showReferences: boolean;
  /** 不折叠的目录（找不到页）要平铺所有路线；侧边栏和抽屉用可开合的选项 */
  allRoutes?: boolean;
}

const { items, references, sections, currentPageId, currentReference, showReferences, allRoutes = false } = Astro.props;
const stepHref = (step: OutlineStep) => withBase(pathOf({ kind: 'step', id: step.id, title: step.title }));
/** 分叉点的一个选项默认展开：本机选过的，或当前页就在这个选项里 */
const optionOpen = (option: OutlineBranch['options'][number]) => option.selected || option.steps.some((step) => step.current);
/** 侧边栏里的页面名去掉“方案一：”前缀，路线名已经在上面一行（作者 2026-10-23） */
const navLabel = (title: string) => title.replace(/^方案[一二三四五六七八九十]+：/, '');
/** 小节列表只挂在当前项（共享步骤在每个选项下各一份，只有一份是当前项）或当前参考页 */
const sectionsFor = (id: string, current: boolean) => current && sections.length > 0 && id === (currentReference ?? currentPageId);
---

<ol>
  {
    items.map((item) =>
      item.kind === 'step' ? (
        <li class="toc-step" data-toc-step={item.id} data-off-route={item.onRoute ? undefined : ''}>
          <a href={stepHref(item)} aria-current={item.current ? 'page' : undefined}>
            <span class="toc-label">{navLabel(item.title)}</span>
            {item.principleOnly && <span class="toc-tag">原理</span>}
            {item.skippable && <span class="toc-tag">可跳过</span>}
          </a>
          <TocSections sections={sectionsFor(item.id, item.current) ? sections : []} />
        </li>
      ) : item.kind === 'choose' ? (
        <li class="toc-step" data-toc-choose={item.fork}>
          <a href={withBase(pathOf({ kind: 'choose', id: item.id, title: item.title }))} aria-current={item.current ? 'page' : undefined}>
            <span class="toc-label">{navLabel(item.title)}</span>
          </a>
          <TocSections sections={sectionsFor(item.id, item.current) ? sections : []} />
        </li>
      ) : allRoutes ? (
        <li>
          {item.options.map((option, i) => (
            <div class="toc-route" data-toc-option={option.id}>
              <p class="toc-route-label">
                {i > 0 && '或：'}
                {option.title}
              </p>
              <ol>
                {option.steps.map((step) => (
                  <li class="toc-step" data-toc-step={step.id} data-off-route={step.onRoute ? undefined : ''}>
                    <a href={stepHref(step)} aria-current={step.current ? 'page' : undefined}>
                      <span class="toc-label">{navLabel(step.title)}</span>
                      {step.principleOnly && <span class="toc-tag">原理</span>}
                      {step.skippable && <span class="toc-tag">可跳过</span>}
                    </a>
                    <TocSections sections={sectionsFor(step.id, step.current) ? sections : []} />
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </li>
      ) : (
        <li class="toc-route-group">
          {item.options.map((option) => (
            <details class="toc-option-details" data-toc-option={option.id} open={optionOpen(option)}>
              <summary class="toc-route-label">{option.title}</summary>
              <ol>
                {option.steps.map((step) => (
                  <li class="toc-step" data-toc-step={step.id} data-off-route={step.onRoute ? undefined : ''}>
                    <a href={stepHref(step)} aria-current={step.current ? 'page' : undefined}>
                      <span class="toc-label">{navLabel(step.title)}</span>
                      {step.principleOnly && <span class="toc-tag">原理</span>}
                      {step.skippable && <span class="toc-tag">可跳过</span>}
                    </a>
                    <TocSections sections={sectionsFor(step.id, step.current) ? sections : []} />
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </li>
      ),
    )
  }
  {
    showReferences && references.length > 0 && (
      <li>
        <ol class="toc-reference">
          {references.map((reference) => (
            <li class="toc-step">
              <a href={withBase(`/${reference.id}/`)} aria-current={reference.id === currentReference ? 'page' : undefined}>
                <span class="toc-label">{reference.title}</span>
              </a>
              <TocSections sections={sectionsFor(reference.id, reference.id === currentReference) ? sections : []} />
            </li>
          ))}
        </ol>
      </li>
    )
  }
</ol>
