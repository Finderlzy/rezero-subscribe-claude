---
/**
 * 页脚（design §4.0，v2.2 D6）：所有页面最底部一行 13px --text-faint 的非官方声明，上面一条 1px --border 细线。
 * 用它的原因只有一个：站点用了 Claude Code 的官方像素小形象（D6），要说明这是个人教程。
 * 放在 BaseLayout 里，每页都有；首页、步骤页、附录页、找不到页都不必各写一遍。
 */
const DISCLAIMER = '本站是个人教程，与 Anthropic 无关。';
---

<footer class="site-footer">
  <p><small>{DISCLAIMER}</small></p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    padding: var(--space-4) 0;
    border-top: var(--border-width) solid var(--border);
  }

  /* 宽度和正文栏一样（--content-width），字号写在里面的 <small> 上，左缘和正文对齐 */
  .site-footer p {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    box-sizing: border-box;
    line-height: var(--lh-meta);
  }

  .site-footer small {
    color: var(--text-faint);
    font-size: var(--fs-caption);
  }
</style>
